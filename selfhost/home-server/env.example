# Settings for the Standard Notes home server. Copy to /var/lib/sn/.env
# (inside the Alpine root) and replace every CHANGE value. The server reads
# ONLY this file: environment variables are ignored.
# Generate each secret with:  openssl rand -hex 32   (or: head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')

PORT=3000
LOG_LEVEL=info
NODE_ENV=production

# CHANGE: secrets, 64 hex characters each.
JWT_SECRET=
AUTH_JWT_SECRET=
ENCRYPTION_SERVER_KEY=
PSEUDO_KEY_PARAMS_KEY=
VALET_TOKEN_SECRET=

# CHANGE: the public https address of this server (attachments use the
# same address).
FILES_SERVER_URL=https://sync.example.com

# CHANGE: the web app address(es) allowed to use this server, comma-separated,
# https:// and no trailing slash. localhost and the apps are always allowed.
CORS_ALLOWED_ORIGINS=https://notes.example.com
CORS_ORIGIN_STRICT_MODE_ENABLED=true

# CHANGE: the server's domain. Lax works because the web app and the
# server share one domain (notes.example.com / sync.example.com).
COOKIE_DOMAIN=sync.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_PARTITIONED=false

# Where your (end-to-end encrypted) data lives. Keep it out of /opt/sn so
# an update never touches it.
DB_SQLITE_DATABASE_PATH=/var/lib/sn/home_server.sqlite
FILE_UPLOAD_PATH=/var/lib/sn/uploads

# Redis, started by start.sh on localhost (the attachment service needs it).
REDIS_URL=redis://127.0.0.1:6379

# Set to true after creating your own account, then restart.
DISABLE_USER_REGISTRATION=false
